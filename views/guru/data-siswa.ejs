<%- include('../partials/header') %>
<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
  <div>
    <h1 style="margin:0; font-size:1.5rem;"><%= k.nama_kelas %></h1>
    <p class="bantu">Kode kelas: <strong><%= k.kode_kelas %></strong> &middot; Jumlah: <%= siswa.length %> siswa</p>
  </div>
  <div>
    <button class="btn-staf btn-staf-netral" onclick="window.print()" type="button">
      Cetak Rekap
    </button>
  </div>
</div>

<div class="card-staf">
  <% if (!siswa.length) { %>
    <p class="bantu">Belum ada siswa di kelas ini.</p>
  <% } else { %>
    <div class="tabel-staf-bungkus">
      <table class="tabel-staf">
        <thead>
          <tr>
            <th style="width:50px;">No</th>
            <th>Nama Siswa</th>
            <th>NISN</th>
            <th style="text-align:right;">Poin</th>
            <th style="text-align:center;">Sandi / PIN</th>
          </tr>
        </thead>
        <tbody>
          <% siswa.forEach((s, idx) => { %>
            <tr>
              <td><%= idx + 1 %></td>
              <td><strong><%= s.nama %></strong></td>
              <td><%= s.nisn %></td>
              <td style="text-align:right; font-weight:700; color:var(--warna-aksen);"><%= Number(s.total) %></td>
              <td style="text-align:center; font-family:monospace; font-weight:700; font-size:16px;">
                <%= s.pin %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
