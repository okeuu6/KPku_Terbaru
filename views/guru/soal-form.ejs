<%- include('../partials/header') %>
<div class="card-staf" style="max-width:560px; margin:0 auto;">
  <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
    <span style="font-size:28px;">📝</span>
    <div>
      <h1 style="margin:0; font-size:1.4rem; color:var(--teks); font-weight:800;">
        <%= soal ? 'Ubah Soal Kosa Kata' : 'Tambah Soal Kosa Kata Baru' %>
      </h1>
      <p class="bantu" style="margin:2px 0 0;">Lengkapi kata bahasa Inggris, arti bahasa Indonesia, dan unggah gambar pendukung.</p>
    </div>
  </div>

  <% if (galat) { %>
    <div class="pesan galat">⚠️ <%= galat %></div>
  <% } %>

  <form method="post" action="<%= url('guru/soal-form.php' + (soal ? '?id=' + soal.id_soal : '')) %>" enctype="multipart/form-data" autocomplete="off">
    <%- csrfFieldHtml %>

    <label for="kata">Kata Bahasa Inggris</label>
    <input type="text" id="kata" name="kata" maxlength="100" value="<%= kata %>" placeholder="contoh: APPLE, BOOK, BALL" style="font-weight:700;" required autofocus>

    <label for="arti">Arti Bahasa Indonesia</label>
    <input type="text" id="arti" name="arti" maxlength="100" value="<%= arti %>" placeholder="contoh: Apel, Buku, Bola" required>

    <label for="gambar">Unggah Gambar Kartun Kosa Kata (Choose File)</label>
    <div style="border:2.5px dashed var(--warna-utama); background:#F0FDF4; border-radius:16px; padding:18px; text-align:center; margin-top:6px;">
      <span style="font-size:32px; display:block; margin-bottom:6px;">🖼️</span>
      <input type="file" id="gambar" name="gambar" accept="image/jpeg,image/png,image/webp" <%= soal ? '' : 'required' %> style="display:block; margin:0 auto; max-width:280px; font-weight:700;">
      <p class="bantu" style="margin:8px 0 0; font-size:13px; color:#475569;">
        Format: <strong>JPG, PNG, atau WebP</strong> &middot; Ukuran Maksimal: <strong>1 MB</strong>
        <% if (soal) { %><br><span style="color:var(--warna-aksen); font-weight:700;">(Kosongkan jika gambar tidak ingin diubah)</span><% } %>
      </p>

      <div style="margin-top:14px;">
        <% if (soal) { %>
          <img id="preview" alt="Pratinjau gambar" src="<%= gambarUrl(soal.gambar) %>" style="display:block; margin:0 auto; max-width:160px; max-height:160px; border:2.5px solid var(--border-komik); border-radius:14px; padding:6px; background:#fff; box-shadow:0 4px 0 var(--garis);">
        <% } else { %>
          <img id="preview" alt="Pratinjau gambar" style="display:none; margin:0 auto; max-width:160px; max-height:160px; border:2.5px solid var(--border-komik); border-radius:14px; padding:6px; background:#fff; box-shadow:0 4px 0 var(--garis);">
        <% } %>
      </div>
    </div>

    <div style="display:flex; gap:12px; margin-top:24px;">
      <button class="btn-staf" type="submit" style="padding:12px 24px; font-size:16px;">💾 Simpan Soal</button>
      <a class="btn-staf btn-staf-netral" href="<%= url('guru/soal.php') %>" style="padding:12px 20px; font-size:16px;">Batal</a>
    </div>
  </form>
</div>

<script>
document.getElementById('gambar').addEventListener('change', function () {
  var f = this.files[0];
  var p = document.getElementById('preview');
  if (!f) return;
  if (f.size > <%= Number(config.maxGambarByte) %>) {
    alert('Ukuran gambar maksimal 1 MB.');
    this.value = '';
    p.style.display = 'none';
    return;
  }
  p.src = URL.createObjectURL(f);
  p.style.display = 'block';
});
</script>
<%- include('../partials/footer') %>
