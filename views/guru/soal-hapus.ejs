<%- include('../partials/header') %>
<div class="card-staf" style="max-width:480px; margin:0 auto; text-align:center;">
  <h2 style="margin:0 0 12px; font-size:1.25rem;">Hapus Soal</h2>
  <img style="width:100px; height:100px; object-fit:contain; border:1px solid var(--garis); padding:6px; background:#fff; margin-bottom:12px;" src="<%= gambarUrl(s.gambar) %>" alt="">
  <p style="margin:0 0 20px;">
    Soal "<strong><%= s.kata_inggris %> - <%= s.arti_indonesia %></strong>" beserta gambarnya akan dihapus.
  </p>

  <form method="post" action="<%= url('guru/soal-hapus.php') %>" style="display:flex; gap:10px; justify-content:center;">
    <%- csrfFieldHtml %>
    <input type="hidden" name="id" value="<%= id %>">
    <a class="btn-staf btn-staf-netral" href="<%= url('guru/soal.php') %>">Batal</a>
    <button class="btn-staf btn-staf-merah" type="submit">Hapus</button>
  </form>
</div>
<%- include('../partials/footer') %>
