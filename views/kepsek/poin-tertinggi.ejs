<%- include('../partials/header') %>
<div class="staf-banner">
  <div>
    <h1 style="margin:0; font-size:1.5rem; font-weight:800; color:var(--teks);">
      📊 Laporan Lengkap Nilai Siswa
    </h1>
    <p class="bantu" style="margin:2px 0 0;">Rekapitulasi nilai dan capaian pembelajaran kuis kosa kata bahasa Inggris seluruh siswa.</p>
  </div>
  <div style="display:flex; gap:8px;">
    <button class="btn-staf btn-staf-netral" onclick="window.print()" type="button" style="font-size:14px; padding:8px 14px;">
      🖨️ Cetak Laporan
    </button>
  </div>
</div>

<% if (top3 && top3.length) { %>
  <div class="card-staf" style="text-align:center;">
    <div class="stiker-badge" style="margin-bottom:6px;">🏆 Podium Juara Sekolah</div>
    <div class="podium-wrap" style="margin-top:14px; margin-bottom:6px;">
      <% top3.forEach((s, idx) => {
        const rank = idx + 1;
        const medal = rank === 1 ? '🥇' : (rank === 2 ? '🥈' : '🥉');
      %>
        <div class="podium-item juara-<%= rank %>">
          <div class="podium-avatar"><%= medal %></div>
          <div class="podium-nama" title="<%= s.nama %>"><%= s.nama %></div>
          <div class="podium-skor"><%= s.total %> ⭐</div>
          <div style="font-size:12px; color:var(--teks-muda); font-weight:700;"><%= s.nama_kelas %></div>
          <div class="podium-balok b-<%= rank %>"><%= rank %></div>
        </div>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="card-staf">
  <div style="margin-bottom:16px;">
    <form method="get" action="" style="display:flex; gap:8px; flex-wrap:wrap;">
      <input type="search" name="q" value="<%= q %>" placeholder="Cari nama siswa, NISN, atau kelas..." style="max-width:340px;">
      <button class="btn-staf btn-staf-netral" type="submit">Cari</button>
      <% if (q !== '') { %>
        <a class="btn-staf btn-staf-netral" href="<%= url('kepsek/poin-tertinggi.php') %>">Reset</a>
      <% } %>
    </form>
  </div>

  <% if (!rows.length) { %>
    <p class="bantu"><%= q !== '' ? 'Data siswa tidak ditemukan.' : 'Belum ada data nilai siswa.' %></p>
  <% } else { %>
    <div class="tabel-staf-bungkus">
      <table class="tabel-staf">
        <thead>
          <tr style="background:#F8FAFC;">
            <th style="width:60px; text-align:center;">No</th>
            <th>NISN</th>
            <th>Nama Lengkap Siswa</th>
            <th>Kelas</th>
            <th>Guru Pengampu</th>
            <th style="text-align:right;">Total Poin</th>
            <th>Predikat Capaian</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((r, i) => {
            const tot = Number(r.total);
            let pred = 'Belum Ada Poin';
            let badgeBg = '#F1F5F9';
            let badgeClr = '#475569';
            if (tot >= 100) {
              pred = '⭐⭐⭐ Sangat Baik';
              badgeBg = '#ECFDF5'; badgeClr = '#065F46';
            } else if (tot >= 50) {
              pred = '⭐⭐ Baik';
              badgeBg = '#EFF6FF'; badgeClr = '#1E40AF';
            } else if (tot > 0) {
              pred = '⭐ Cukup';
              badgeBg = '#FFFBEB'; badgeClr = '#92400E';
            }
          %>
            <tr>
              <td style="text-align:center; font-weight:800; color:var(--teks);"><%= i + 1 %></td>
              <td style="font-family:monospace; font-size:14px;"><%= r.nisn %></td>
              <td><strong><%= r.nama %></strong></td>
              <td><span class="peran-label" style="background:#EFF6FF; border-color:#BFDBFE; color:#1E40AF;"><%= r.nama_kelas %></span></td>
              <td><%= r.nama_guru || '-' %></td>
              <td style="text-align:right; font-weight:900; font-size:16px; color:#D97706;">
                <%= tot %> ⭐
              </td>
              <td>
                <span style="display:inline-block; padding:3px 10px; border-radius:12px; font-size:13px; font-weight:700; background:<%= badgeBg %>; color:<%= badgeClr %>; border:1px solid <%= badgeClr %>;">
                  <%= pred %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
