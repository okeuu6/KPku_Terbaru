<%- include('../partials/header') %>
<div class="siswa-zona" style="max-width:520px; margin:0 auto;">
  <div class="card-siswa" style="text-align:center;">
    <div class="stiker-badge">⭐ Tabungan Bintang Belajar</div>
    <h1 style="font-size:28px; font-weight:900; margin:4px 0 12px; color:var(--teks);">Papan Poin Saya</h1>

    <div class="poin-siswa-box" style="margin-bottom:10px;">
      <div style="font-size:18px; font-weight:800; color:#B45309;">Total Koleksi Bintang Kamu</div>
      <div class="poin-siswa-angka"><%= total %></div>
      <div style="font-size:16px; font-weight:700; color:var(--teks);">
        <%= total >= 100 ? '👑 Wah, kamu bintang kelas sejati!' : 'Terus semangat berlatih kuis ya!' %>
      </div>
    </div>
  </div>

  <div class="card-siswa" style="text-align:left;">
    <h2 style="font-size:22px; font-weight:800; margin:0 0 14px; color:var(--teks); display:flex; align-items:center; gap:8px;">
      <span>📜</span> Catatan Latihan Kuis
    </h2>

    <% if (!riwayat.length) { %>
      <div style="text-align:center; padding:20px; background:#F8FAFC; border:2px dashed var(--garis-tebal); border-radius:16px;">
        <p class="bantu" style="font-size:16px; margin:0;">Belum ada riwayat kuis. Yuk mainkan kuis sekarang!</p>
        <a class="btn-siswa btn-siswa-aksen" href="<%= url('siswa/mencocokkan.php') %>" style="margin-top:14px; display:inline-flex; width:auto; padding:10px 20px;">
          Mulai Kuis Pertama
        </a>
      </div>
    <% } else { %>
      <div style="border:2.5px solid var(--border-komik); border-radius:16px; overflow:hidden; box-shadow:0 4px 0 var(--garis-tebal);">
        <table style="width:100%; border-collapse:collapse; font-size:16px;">
          <thead>
            <tr style="background:#FEF08A; border-bottom:2.5px solid var(--border-komik);">
              <th style="padding:12px 14px; text-align:left; font-weight:800; color:var(--border-komik);">Tanggal Latihan</th>
              <th style="padding:12px 14px; text-align:right; font-weight:800; color:var(--border-komik);">Poin Masuk</th>
            </tr>
          </thead>
          <tbody>
            <% riwayat.forEach((r) => { %>
              <tr style="border-bottom:1.5px solid var(--garis); background:#FFFFFF;">
                <td style="padding:12px 14px; font-weight:600; color:#334155;">
                  📅 <%= tglId(r.tanggal) %>
                </td>
                <td style="padding:12px 14px; text-align:right; font-weight:900; color:#D97706; font-size:18px;">
                  +<%= Number(r.nilai) %> ⭐
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div style="margin-top:24px;">
      <a class="btn-siswa btn-siswa-netral" href="<%= url('siswa/menu.php') %>">
        &larr; Kembali ke Menu Utama
      </a>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
